# Safe offline demo defaults. Copy to .env and edit values.
APP_ENV=development
DATABASE_PATH=data/messages.sqlite3
MOCK_DIR=data/mock
WEBHOOK_TOKEN=local-demo-token

# To run actual AI: ANALYZER_MODE=gemini and supply GEMINI_API_KEY
ANALYZER_MODE=fixture
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30

# OAuth Desktop App is the recommended local authentication mode. Run
# python -m app.google_auth once; the API and worker never open a browser.
SHEET_MODE=mock
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leads
GOOGLE_AUTH_MODE=oauth
GOOGLE_OAUTH_CLIENT_FILE=.secrets/google-oauth-client.json
GOOGLE_TOKEN_FILE=.secrets/google-token.json
# Optional legacy/service-account mode: set GOOGLE_AUTH_MODE=service_account.
GOOGLE_CREDENTIALS_FILE=secrets/service-account.json

# To send actual emails: EMAIL_MODE=smtp and configure SMTP credentials
EMAIL_MODE=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=30
SMTP_USERNAME=
SMTP_PASSWORD=                              # Gmail App Password; never commit .env
EMAIL_FROM=
OWNER_EMAIL=
ERROR_EMAIL=

RETRY_LIMIT=5
WORKER_POLL_SECONDS=3
LEASE_SECONDS=300
